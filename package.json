{
  "name": "youtube-auto-fullscreen",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Chrome extension for automatic YouTube fullscreen.",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "node scripts/build.js --watch",
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -p jsconfig.json",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:build": "npm run build && node --test tests/build/artifact.test.js",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run test:build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.0",
    "@types/node": "24.13.5",
    "@vitest/coverage-v8": "5.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
